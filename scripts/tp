#!/data/data/com.termux/files/usr/bin/bash
# ==============================================================================
# TermuxPanel Terminal Management CLI (tp)
# ==============================================================================

PANEL_DIR="$HOME/termux-panel"
if [ ! -d "$PANEL_DIR" ]; then
  # Fallback to current directory or relative
  PANEL_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

show_banner() {
  echo -e "${CYAN}╔══════════════════════════════════════════╗${NC}"
  echo -e "${CYAN}║             TERMUXPANEL                  ║${NC}"
  echo -e "${CYAN}║     Android Hosting Control Plane        ║${NC}"
  echo -e "${CYAN}╚══════════════════════════════════════════╝${NC}"
}

get_wifi_ip() {
  local ip=$(ifconfig wlan0 2>/dev/null | grep 'inet ' | awk '{print $2}')
  if [ -n "$ip" ]; then
    echo "$ip"
    return
  fi
  ip=$(ifconfig 2>/dev/null | grep -A 2 'wlan0' | grep 'inet ' | awk '{print $2}')
  if [ -n "$ip" ]; then
    echo "$ip"
    return
  fi
  ip=$(node -e "const n=require('os').networkInterfaces();for(const k in n){for(const i of n[k]){if(i.family==='IPv4'&&!i.internal){console.log(i.address);process.exit(0);}}}" 2>/dev/null || echo "")
  echo "$ip"
}

check_status() {
  echo -e "\n${BLUE}▶ Checking TermuxPanel Status...${NC}"
  
  # Detect Wi-Fi LAN IP
  WIFI_IP=$(get_wifi_ip)
  
  # Check Node server
  if pgrep -f "server.js" > /dev/null; then
    echo -e "  [Panel Service]     ${GREEN}RUNNING${NC}"
    echo -e "    • Local Phone:    ${CYAN}http://127.0.0.1:9000${NC}"
    if [ -n "$WIFI_IP" ]; then
      echo -e "    • PC on same Wi-Fi: ${GREEN}http://${WIFI_IP}:9000${NC}"
    fi
  else
    echo -e "  [Panel Service]     ${RED}STOPPED${NC}"
  fi

  # Check Cloudflare Tunnel
  if pgrep -x "cloudflared" > /dev/null; then
    echo -e "  [Cloudflare Tunnel] ${GREEN}RUNNING${NC}"
  else
    echo -e "  [Cloudflare Tunnel] ${YELLOW}STOPPED / NOT RUNNING${NC}"
  fi

  # Check Crond
  if pgrep -x "crond" > /dev/null; then
    echo -e "  [Cron Daemon]       ${GREEN}RUNNING${NC}"
  else
    echo -e "  [Cron Daemon]       ${YELLOW}STOPPED${NC}"
  fi
  echo ""
}

start_panel() {
  echo -e "\n${BLUE}▶ Starting TermuxPanel Server...${NC}"
  cd "$PANEL_DIR/backend" || exit 1
  mkdir -p "$PANEL_DIR/logs" "$PANEL_DIR/data" "$PANEL_DIR/config"

  # Acquire wake lock if in Termux
  if command -v termux-wake-lock >/dev/null 2>&1; then
    termux-wake-lock
    echo -e "  ${GREEN}✓${NC} Termux wake-lock acquired"
  fi

  # Start crond if available
  if command -v crond >/dev/null 2>&1; then
    pgrep -x crond >/dev/null || crond
  fi

  # Stop any stale instance & free port 9000
  pkill -9 -f "server.js" 2>/dev/null || true
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 9000/tcp 2>/dev/null || true
  fi
  sleep 1

  # Start node server in background
  nohup node server.js > "$PANEL_DIR/logs/panel.log" 2>&1 &
  SERVER_PID=$!
  sleep 2

  if pgrep -f "server.js" > /dev/null; then
    echo -e "  ${GREEN}✓${NC} TermuxPanel server is RUNNING (PID: $SERVER_PID)"
  else
    echo -e "  ${RED}✗ Server failed to start! Last logs:${NC}"
    tail -n 10 "$PANEL_DIR/logs/panel.log" 2>/dev/null
  fi

  # Check if cloudflared token configured
  if [ -f "$PANEL_DIR/config/cloudflare-token" ]; then
    if command -v cloudflared >/dev/null 2>&1; then
      CF_TOKEN=$(cat "$PANEL_DIR/config/cloudflare-token" | tr -d '\r\n')
      if [ -n "$CF_TOKEN" ]; then
        pkill -9 -x "cloudflared" 2>/dev/null || true
        sleep 1
        nohup cloudflared tunnel run --token "$CF_TOKEN" > "$PANEL_DIR/logs/cloudflared.log" 2>&1 &
        echo -e "  ${GREEN}✓${NC} Cloudflare Tunnel launched (PID: $!)"
      fi
    fi
  fi

  WIFI_IP=$(get_wifi_ip)
  echo -e "\n${GREEN}TermuxPanel is LIVE at:${NC}"
  echo -e "  • Local Phone:      ${CYAN}http://127.0.0.1:9000${NC}"
  if [ -n "$WIFI_IP" ]; then
    echo -e "  • PC on same Wi-Fi: ${GREEN}http://${WIFI_IP}:9000${NC}\n"
  else
    echo ""
  fi
}

stop_panel() {
  echo -e "\n${BLUE}▶ Stopping TermuxPanel Server...${NC}"
  pkill -9 -f "server.js" 2>/dev/null || true
  pkill -9 -x "cloudflared" 2>/dev/null || true
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 9000/tcp 2>/dev/null || true
  fi
  if command -v sv >/dev/null 2>&1 && [ -d "$PREFIX/var/service/termux-panel" ]; then
    sv down termux-panel 2>/dev/null || true
  fi
  sleep 1
  echo -e "  ${GREEN}✓${NC} TermuxPanel stopped\n"
}

restart_panel() {
  stop_panel
  sleep 1
  start_panel
}

view_logs() {
  echo -e "\n${BLUE}▶ Tailing last 30 lines of panel.log (Ctrl+C to exit):${NC}\n"
  if [ -f "$PANEL_DIR/logs/panel.log" ]; then
    tail -n 30 -f "$PANEL_DIR/logs/panel.log"
  else
    echo -e "${YELLOW}No log file found at $PANEL_DIR/logs/panel.log${NC}"
  fi
}

configure_cloudflare() {
  bash "$PANEL_DIR/installer/cloudflare.sh"
}

create_backup() {
  echo -e "\n${BLUE}▶ Creating Full Backup Archive...${NC}"
  TIMESTAMP=$(date +"%Y%m%d_%H%M%S")
  BACKUP_FILE="$PANEL_DIR/data/backups/backup-cli-$TIMESTAMP.tar.gz"
  mkdir -p "$PANEL_DIR/data/backups"
  tar -czf "$BACKUP_FILE" -C "$PANEL_DIR" storage data config
  echo -e "${GREEN}✓ Backup created:${NC} $BACKUP_FILE\n"
}

interactive_menu() {
  while true; do
    WIFI_IP=$(get_wifi_ip)
    show_banner
    echo -e "  ${YELLOW}1.${NC} Open Panel URL (http://127.0.0.1:9000)"
    if [ -n "$WIFI_IP" ]; then
      echo -e "     ${GREEN}PC Link: http://${WIFI_IP}:9000${NC}"
    fi
    echo -e "  ${YELLOW}2.${NC} Server Status"
    echo -e "  ${YELLOW}3.${NC} Start Server"
    echo -e "  ${YELLOW}4.${NC} Stop Server"
    echo -e "  ${YELLOW}5.${NC} Restart Server"
    echo -e "  ${YELLOW}6.${NC} View Live Logs"
    echo -e "  ${YELLOW}7.${NC} Configure Cloudflare Tunnel"
    echo -e "  ${YELLOW}8.${NC} Create Backup"
    echo -e "  ${YELLOW}9.${NC} Run Self Health Check"
    echo -e "  ${YELLOW}0.${NC} Exit"
    echo ""
    read -p "Select an option [0-9]: " choice

    case $choice in
      1)
        if command -v termux-open-url >/dev/null 2>&1; then
          termux-open-url "http://127.0.0.1:9000"
        else
          echo -e "\n  Phone: ${CYAN}http://127.0.0.1:9000${NC}"
          if [ -n "$WIFI_IP" ]; then
            echo -e "  PC on same Wi-Fi: ${GREEN}http://${WIFI_IP}:9000${NC}\n"
          fi
        fi
        ;;
      2) check_status ;;
      3) start_panel ;;
      4) stop_panel ;;
      5) restart_panel ;;
      6) view_logs ;;
      7) configure_cloudflare ;;
      8) create_backup ;;
      9)
        echo -e "\n${BLUE}▶ Health Check:${NC}"
        node -v && python --version && php -v && sqlite3 --version
        echo ""
        ;;
      0)
        echo -e "\nGoodbye!"
        exit 0
        ;;
      *)
        echo -e "\n${RED}Invalid option.${NC}\n"
        ;;
    esac
    read -p "Press Enter to continue..."
  done
}

# CLI Argument dispatcher
case "$1" in
  status) check_status ;;
  start) start_panel ;;
  stop) stop_panel ;;
  restart) restart_panel ;;
  logs) view_logs ;;
  cloudflare|tunnel) configure_cloudflare ;;
  backup) create_backup ;;
  *) interactive_menu ;;
esac
