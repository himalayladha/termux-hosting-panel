# Node Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sensitive Secrets, Config & Tokens
config/*
!config/.gitkeep
*.token
*.env
*.env.*
*.key
*.pem
*.crt
*.cert
*.p12

# Database & Runtime Data
data/*.db*
data/*.sqlite*
data/*.sqlite3*
data/tmp/
data/backups/*
!data/backups/.gitkeep

# Website Storage (User data)
storage/websites/*
!storage/websites/.gitkeep

# Runtime Logs
logs/*.log
logs/websites/*
!logs/websites/.gitkeep

# OS / Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
